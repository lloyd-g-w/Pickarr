# Pickarr environment file. Copy to .env and edit what you need.
#
# Everything here is OPTIONAL: these values are only defaults and overrides.
# The UI at http://localhost:8484 is the primary way to configure Pickarr, and
# values set here win over the UI after a restart.

# --- Service ---------------------------------------------------------------
# PORT=8484
# HOST=0.0.0.0
# DATA_DIR=/data                 # config.json, history.jsonl, auth.json
# STATIC_DIR=/app/static         # web UI assets
# LOG_LEVEL=info                 # debug | info | warning | error
# TZ=Etc/UTC

# --- Access control --------------------------------------------------------
# Leave these unset to create the admin account in the UI on first load.
# Setting them defines the login without storing anything on disk.
# PICKARR_USERNAME=admin
# PICKARR_PASSWORD=change-me-please
# PICKARR_AUTH_REQUIRED=true     # false disables the login requirement
# PICKARR_API_KEY=               # generated automatically if unset; shown in
#                                # the UI under Security (X-Api-Key / ?apikey=)

# --- Sonarr ----------------------------------------------------------------
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=                # Sonarr: Settings -> General -> API Key

# --- Radarr ----------------------------------------------------------------
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=                # Radarr: Settings -> General -> API Key

# --- LLM (any OpenAI-compatible /chat/completions server) ------------------
# LLM_ENABLED=false
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=                   # may be empty for local servers
# LLM_MODEL=gpt-4o-mini

# --- Hard rules (never overridden by the AI) -------------------------------
# MAX_RELEASE_SIZE_GIB=25
# MIN_SEEDERS=3
# DISALLOWED_CODECS=XviD
# BLOCKED_RELEASE_GROUPS=
# ALLOW_REMUX=true

# --- Structured preferences ------------------------------------------------
# PREFERRED_CODECS=x265,x264
# PREFERRED_SOURCES=WEB-DL,Bluray
# PREFERRED_RELEASE_GROUPS=FLUX,NTb,HONE
# PREFERRED_LANGUAGES=English
# HDR_PREFERENCE=prefer          # prefer | neutral | avoid
# DOLBY_VISION_PREFERENCE=neutral
# PREFER_REMUX=false

# --- Natural language preferences -----------------------------------------
# NL_PREFERENCES="Prefer reasonably sized 1080p WEB-DLs rather than huge files. Prefer x265 when quality is comparable."

# --- Automatic mode --------------------------------------------------------
# AUTO_MODE_ENABLED=false
# AUTO_MODE_GRAB=false           # false = dry run: log what would be grabbed
# AUTO_MODE_INTERVAL_SECONDS=900

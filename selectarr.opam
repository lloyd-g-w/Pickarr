  "lwt"
  "lwt_ppx"
  "yojson"
  "cohttp-lwt-unix"
  "ptime"
  "logs"
  "fmt"
  "uri"
  "re"
  "digestif"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
